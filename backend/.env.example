# Скопируйте в .env и заполните. Все переменные проверяются при старте (src/core/configs/env.validation.ts)

NODE_ENV=development
PORT=4200
# Количество прокси перед приложением (nginx, балансировщик). 0 — не доверять X-Forwarded-For
TRUST_PROXY=0

DATABASE_URL="postgresql://ticketor:ticketor@localhost:5432/ticketor"
REDIS_URL="redis://localhost:6379"

CORS_ORIGIN="http://localhost:3000"
CORS_CREDENTIALS=true

# Секреты: минимум 32 символа, access и refresh должны отличаться (например: openssl rand -base64 48)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=604800

COOKIE_PATH=/
COOKIE_REFRESH_PATH=/api/v1/auth
# strict | lax | none (none — только при NODE_ENV=production)
COOKIE_SAME_SITE=strict

THROTTLE_TTL=60000
THROTTLE_LIMIT=20

OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=ticketor
